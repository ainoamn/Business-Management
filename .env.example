# Run pnpm setup:env to generate LOCAL credentials. Do not use these placeholders.
NODE_ENV=development
DEPLOYMENT_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
POSTGRES_DB=work_management
POSTGRES_USER=work_migrator
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_OWNER_PASSWORD
APP_DATABASE_PASSWORD=REPLACE_WITH_RANDOM_APP_PASSWORD
DATABASE_URL=postgresql://work_app:REPLACE_WITH_RANDOM_APP_PASSWORD@127.0.0.1:55432/work_management?schema=public
MIGRATION_DATABASE_URL=postgresql://work_migrator:REPLACE_WITH_RANDOM_OWNER_PASSWORD@127.0.0.1:55432/work_management?schema=public
REDIS_PASSWORD=REPLACE_WITH_RANDOM_REDIS_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_RANDOM_REDIS_PASSWORD@127.0.0.1:56379
S3_ENDPOINT=http://127.0.0.1:59000
S3_REGION=us-east-1
S3_BUCKET=work-private
S3_ACCESS_KEY=REPLACE_WITH_RANDOM_ACCESS_KEY
S3_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_KEY
MAIL_DELIVERY_MODE=outbox
# Production: configure SMTP before registration, invitations and recovery.
# SMTP_URL=smtps://USERNAME:PASSWORD@SMTP_HOST:465
# SMTP_FROM=no-reply@example.com
# Development uses private local files; staging/production use S3.
# DOCUMENT_STORAGE_MODE=local
DOCUMENT_MAX_BYTES=26214400
DOCUMENT_SCANNER_MODE=none
# AI stays disabled until a platform provider/model and organization consent are configured.
# Production: keep this 32-byte encryption key in a secret file and back it up separately.
# AI_CREDENTIAL_KEY_FILE=C:/private-secrets/work-ai.key
# Alternative: AI_CREDENTIAL_KEY=BASE64_ENCODED_RANDOM_32_BYTES
# Development generates an ignored .local/secrets/ai.key automatically.
# Compatible providers require an HTTPS base endpoint configured by the server operator.
# AI_COMPATIBLE_BASE_URL=https://your-approved-provider.example/v1
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# Hosted payment provider (work-hosted-payments-v1). All values required together.
# PAYMENT_ENDPOINT=https://payments.example/v1
# PAYMENT_API_KEY=replace-with-provider-api-key
# PAYMENT_WEBHOOK_SECRET=replace-with-32-plus-char-secret
# PAYMENT_MODE=SANDBOX
# PAYMENT_CHECKOUT_HOSTS=checkout.example,pay.example
# MFA encryption (optional dedicated key; otherwise AI_CREDENTIAL_KEY is used)
# MFA_CREDENTIAL_KEY=BASE64_ENCODED_RANDOM_32_BYTES
# Optional notification channels
# SMS_PROVIDER_URL=https://sms.example/send
# WHATSAPP_PROVIDER_URL=https://whatsapp.example/send
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# PDF report rendering: install the matching Playwright Chromium runtime.
# Optionally select an administrator-provisioned executable; never a request parameter.
# REPORT_CHROMIUM_PATH=C:/path/to/chromium/chrome.exe
