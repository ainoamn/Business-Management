{
  "name": "work-management-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": { "node": ">=22.12.0 <25" },
  "scripts": {
    "setup:env": "node infrastructure/scripts/setup-env.mjs",
    "db:local": "node infrastructure/scripts/local-postgres.mjs",
    "db:local:stop": "node infrastructure/scripts/local-postgres.mjs --stop",
    "billing:catalog": "node infrastructure/scripts/billing-catalog.mjs",
    "platform:bootstrap": "node infrastructure/scripts/platform-bootstrap.mjs",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "db:generate": "pnpm --filter @work/api db:generate",
    "db:validate": "dotenv -e .env -- pnpm --filter @work/api db:validate",
    "db:migrate": "node infrastructure/scripts/migrate.mjs",
    "build:packages": "pnpm --filter @work/shared-types --filter @work/shared-schemas --filter @work/ui -r build",
    "build": "pnpm build:packages && pnpm --filter @work/api build && pnpm --filter @work/web build",
    "typecheck": "pnpm build:packages && pnpm -r typecheck && tsc --noEmit -p tsconfig.tests.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:integration": "dotenv -e .env -- vitest run --config vitest.integration.config.ts",
    "test:platform": "dotenv -e .env -- vitest run --config vitest.platform.config.ts",
    "test:work": "dotenv -e .env -- vitest run --config vitest.work.config.ts",
    "test:tenant": "dotenv -e .env -- vitest run --config vitest.integration.config.ts tests/integration/foundation.test.ts -t \"PostgreSQL organization isolation\"",
    "test:platform:browser": "node tests/browser/platform.verify.mjs",
    "test:e2e": "dotenv -e .env -- playwright test",
    "test:ui": "playwright test --config playwright.ui.config.ts",
    "test:perf": "node tests/performance/smoke.mjs",
    "test:restore": "node tests/restore/restore-drill.mjs",
    "dev": "dotenv -e .env -- concurrently -k -n api,web \"pnpm --filter @work/api dev\" \"pnpm --filter @work/web dev\"",
    "start:api": "dotenv -e .env -- pnpm --filter @work/api start",
    "start:web": "pnpm --filter @work/web start",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.19.0",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^10.0.0",
    "eslint": "^10.14.0",
    "supertest": "^7.1.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "~4.1.12"
  },
  "optionalDependencies": {"@embedded-postgres/windows-x64":"18.6.0-beta.19"},
  "pnpm": {
    "onlyBuiltDependencies": ["@nestjs/core", "@prisma/client", "@prisma/engines", "prisma", "esbuild", "sharp", "unrs-resolver"],
    "overrides": {"next>postcss":"^8.5.18","@prisma/config>deepmerge-ts":"^8.0.2","@nestjs/platform-express>multer":"^2.5.0","@nestjs/swagger>js-yaml":"^5.4.1","exceljs>uuid":"11.1.1","minimatch":"^11.0.1"}
  }
}
