generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique @db.VarChar(254)
  passwordHash String       @map("password_hash")
  displayName  String       @map("display_name") @db.VarChar(120)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt    DateTime?    @map("deleted_at") @db.Timestamptz(3)
  disabledAt   DateTime?    @map("disabled_at") @db.Timestamptz(3)
  username String? @unique @db.VarChar(40)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  bhdSub String? @unique @map("bhd_sub") @db.Uuid
  mfaEnabled Boolean @default(false) @map("mfa_enabled")
  mfaVersion Int @default(0) @map("mfa_version")
  mfaLastCounter BigInt? @map("mfa_last_counter")
  mfaSecretEnc String? @map("mfa_secret_enc")
  mfaVerifiedAt DateTime? @map("mfa_verified_at") @db.Timestamptz(3)
  actionTokens UserActionToken[]
  aiRequests AiRequest[]
  memberships Membership[]
  sessions     UserSession[]
  @@index([displayName(ops: raw("gin_trgm_ops"))],type:Gin,map:"users_search_name")
  @@index([email(ops: raw("gin_trgm_ops"))],type:Gin,map:"users_search_email")
  @@map("users")
}

model Organization {
 holidays OrganizationHoliday[]
 branding OrganizationBranding?
 supportCases SupportCase[]
 capacities MembershipCapacity[]
 portfolios ProjectPortfolio[]
  id           String       @id @default(uuid()) @db.Uuid
  name         String       @db.VarChar(160)
  slug         String       @unique @db.VarChar(80)
  locale       String       @default("ar") @db.VarChar(5)
  timezone     String       @default("Asia/Muscat") @db.VarChar(64)
  currency     String       @default("OMR") @db.VarChar(3)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt    DateTime?    @map("deleted_at") @db.Timestamptz(3)
  memberships Membership[]
  auditLogs    AuditLog[]
  suspendedAt  DateTime?    @map("suspended_at") @db.Timestamptz(3)
  subscriptions PlatformSubscription[]
  billingOrders BillingOrder[]
  billingEvents BillingEvent[]
  billingTrial BillingTrialUse?
  invoices PlatformInvoice[]
  ledger PlatformLedgerEntry[]
  settings OrganizationSettings?
  branches OrganizationBranch[]
  departments Department[]
  sections Section[]
  teams Team[]
  roles OrganizationRole[]
  invitations Invitation[]
  projects Project[]
  tasks Task[]
  counters WorkCounter[]
  taskStatuses TaskStatus[]
  taskTransitions TaskTransition[]
  timeEntries TimeEntry[]
  timers ActiveTimer[]
  meetings Meeting[]
  notifications WorkNotification[]
  notificationPreferences NotificationPreference[]
  reminderDeliveries ReminderDelivery[]
  requestTypes InternalRequestType[]
  requests InternalRequest[]
  budgets OperationalBudget[]
  expenses OperationalExpense[]
  documentFolders DocumentFolder[]
  documents WorkDocument[]
  storageUsage OrganizationStorageUsage?
  workflows Workflow[]
  workflowEvents WorkflowEvent[]
  workflowUsage WorkflowMonthlyUsage[]
  aiSettings AiOrganizationSettings?
  aiUsage AiMonthlyUsage[]
  aiWallet AiWallet?
  aiCredits AiCreditEntry[]
  aiConversations AiConversation[]
  aiRequests AiRequest[]
  aiMessages AiMessage[]
  aiDrafts AiDraft[]
  aiAudit AiAudit[]
  integrations OrganizationIntegration[]
  @@map("organizations")
}

model Membership {
 holidaysCreated OrganizationHoliday[]
 brandingUpdated OrganizationBranding[]
 profile MemberProfile? @relation("member_profile_subject")
 managedProfiles MemberProfile[] @relation("member_profile_manager")
 updatedProfiles MemberProfile[] @relation("member_profile_editor")
 supportCases SupportCase[] @relation("SupportCreator")
 supportMessages SupportMessage[] @relation("SupportMessageAuthor")
 capacities MembershipCapacity[] @relation("capacity_subject")
 createdCapacities MembershipCapacity[] @relation("capacity_creator")
 ownedPortfolios ProjectPortfolio[]
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  role           String       @db.VarChar(40)
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  organization   Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  user           User         @relation(fields:[userId],references:[id],onDelete:Restrict)
  branchId String? @map("branch_id") @db.Uuid
  departmentId String? @map("department_id") @db.Uuid
  sectionId String? @map("section_id") @db.Uuid
  jobTitle String @default("") @map("job_title") @db.VarChar(120)
  branch OrganizationBranch? @relation("MemberBranch",fields:[organizationId,branchId],references:[organizationId,id],onDelete:Restrict)
  department Department? @relation("MemberDepartment",fields:[organizationId,departmentId],references:[organizationId,id],onDelete:Restrict)
  section Section? @relation(fields:[organizationId,sectionId],references:[organizationId,id],onDelete:Restrict)
  managedBranches OrganizationBranch[] @relation("BranchManager")
  managedDepartments Department[] @relation("DepartmentManager")
  ledTeams Team[] @relation("TeamLeader")
  teams TeamMember[]
  roles MembershipRole[]
  invitations Invitation[] @relation("Inviter")
  timeEntries TimeEntry[]
  aiConsent AiOrganizationSettings[]
  billingOrders BillingOrder[]
  billingEvents BillingEvent[]
  billingTrials BillingTrialUse[]
  aiConversations AiConversation[]
  aiRequests AiRequest[]
  aiAudit AiAudit[]
  @@unique([organizationId,id])
  @@unique([organizationId,id,userId])
  @@unique([organizationId,userId])
  @@index([userId,active])
  @@map("memberships")
}

model UserSession {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash") @db.VarChar(64)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  user       User     @relation(fields:[userId],references:[id],onDelete:Cascade)
  deviceName String @default("") @map("device_name") @db.VarChar(160)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  aiRequests AiRequest[]
  billingOrders BillingOrder[]
  @@unique([id,userId])
  @@index([userId,expiresAt])
  @@index([expiresAt])
  @@map("user_sessions")
}

model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  actorId        String       @map("actor_id") @db.Uuid
  action         String       @db.VarChar(80)
  resourceType   String       @map("resource_type") @db.VarChar(80)
  resourceId     String       @map("resource_id") @db.Uuid
  requestId      String       @map("request_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  organization   Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  @@index([organizationId,createdAt])
  @@index([actorId,createdAt])
  @@map("audit_logs")
}

model PlatformRole {
  id String @id @default(uuid()) @db.Uuid
  name String @unique @db.VarChar(80)
  permissions String[]
  accounts PlatformAccount[]
  @@map("platform_roles")
}

model PlatformAccount {
 supportMessages SupportMessage[]
  id String @id @default(uuid()) @db.Uuid
  email String @unique @db.VarChar(254)
  displayName String @map("display_name") @db.VarChar(120)
  passwordHash String @map("password_hash")
  isOwner Boolean @default(false) @map("is_owner")
  disabledAt DateTime? @map("disabled_at") @db.Timestamptz(3)
  roleId String? @map("role_id") @db.Uuid
  mfaEnabled Boolean @default(false) @map("mfa_enabled")
  mfaVersion Int @default(0) @map("mfa_version")
  mfaLastCounter BigInt? @map("mfa_last_counter")
  mfaSecretEnc String? @map("mfa_secret_enc")
  mfaVerifiedAt DateTime? @map("mfa_verified_at") @db.Timestamptz(3)
  role PlatformRole? @relation(fields:[roleId],references:[id],onDelete:Restrict)
  sessions PlatformSession[]
  aiPromptVersions AiPromptVersion[]
  aiCreditGrants AiCreditEntry[]
  billingCoupons BillingCoupon[]
  billingEvents BillingEvent[]
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@map("platform_accounts")
}

model PlatformSession {
  id String @id @default(uuid()) @db.Uuid
  accountId String @map("account_id") @db.Uuid
  account PlatformAccount @relation(fields:[accountId],references:[id],onDelete:Cascade)
  tokenHash String @unique @map("token_hash") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  @@index([accountId,expiresAt])
  @@map("platform_sessions")
}

model PlatformLoginAttempt {
  id String @id @default(uuid()) @db.Uuid
  key String @db.VarChar(64)
  succeeded Boolean
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([key,createdAt])
  @@map("platform_login_attempts")
}

model PlatformAudit {
  id String @id @default(uuid()) @db.Uuid
  actorId String? @map("actor_id") @db.Uuid
  action String @db.VarChar(80)
  resource String @db.VarChar(80)
  resourceId String? @map("resource_id") @db.Uuid
  requestId String @map("request_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([createdAt])
  @@map("platform_audit")
}

model PlatformPlan {
  id String @id @default(uuid()) @db.Uuid
  code String @unique @default(uuid()) @db.VarChar(80)
  name String @unique @db.VarChar(80)
  description String @db.VarChar(500)
  price Decimal @db.Decimal(12,3)
  currency String @default("OMR") @db.VarChar(3)
  maxSeats Int @map("max_seats")
  storageMb Int @map("storage_mb")
  aiCredits Int @map("ai_credits")
  automationRuns Int @default(100) @map("automation_runs")
  activeWorkflows Int @default(5) @map("active_workflows")
  active Boolean @default(true)
  annualPrice Decimal? @map("annual_price") @db.Decimal(12,3)
  maxProjects Int? @map("max_projects")
  features String[] @default(["TASKS","PROJECTS","CALENDAR","DOCUMENTS","NOTIFICATIONS","AI_BASIC","AUTOMATION","TEAMS","TIME","BUDGETS","ADVANCED_REPORTS","AI_ADVANCED","ADVANCED_PERMISSIONS","PORTFOLIOS","API","INTEGRATIONS","SSO","PRIVATE_HOSTING"])
  trialDays Int @default(0) @map("trial_days")
  graceDays Int @default(7) @map("grace_days")
  customPricing Boolean @default(false) @map("custom_pricing")
  public Boolean @default(false)
  version Int @default(1)
  subscriptions PlatformSubscription[]
  freeFor BillingSettings[] @relation("BillingFreePlan")
  trialFor BillingSettings[] @relation("BillingTrialPlan")
  billingOrders BillingOrder[]
  billingTrials BillingTrialUse[]
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@map("platform_plans")
}

model BillingSettings {
  id String @id @default("main") @db.VarChar(20)
  freePlanId String? @map("free_plan_id") @db.Uuid
  freePlan PlatformPlan? @relation("BillingFreePlan",fields:[freePlanId],references:[id],onDelete:Restrict)
  trialPlanId String? @map("trial_plan_id") @db.Uuid
  trialPlan PlatformPlan? @relation("BillingTrialPlan",fields:[trialPlanId],references:[id],onDelete:Restrict)
  trialSeats Int @default(3) @map("trial_seats")
  manualPaymentsEnabled Boolean @default(false) @map("manual_payments_enabled")
  paymentInstructions String @default("") @map("payment_instructions") @db.VarChar(4000)
  supportEmail String @default("") @map("support_email") @db.VarChar(254)
  version Int @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@map("billing_settings")
}
model BillingCoupon {
  id String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(40)
  name String @db.VarChar(120)
  kind String @db.VarChar(10)
  basisPoints Int? @map("basis_points")
  amount Decimal? @db.Decimal(12,3)
  startsAt DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt DateTime @map("ends_at") @db.Timestamptz(3)
  maxUses Int @map("max_uses")
  perOrganization Int @map("per_organization")
  allowedPlanIds String[] @map("allowed_plan_ids") @db.Uuid
  redeemedCount Int @default(0) @map("redeemed_count")
  reservedCount Int @default(0) @map("reserved_count")
  active Boolean @default(false)
  version Int @default(1)
  createdById String @map("created_by_id") @db.Uuid
  createdBy PlatformAccount @relation(fields:[createdById],references:[id],onDelete:Restrict)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  orders BillingOrder[]
  uses BillingCouponUse[]
  @@index([active,endsAt])
  @@map("billing_coupons")
}
model PlatformSubscription {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  planId String @map("plan_id") @db.Uuid
  plan PlatformPlan @relation(fields:[planId],references:[id],onDelete:Restrict)
  status String @db.VarChar(20)
  seats Int
  unitPrice Decimal @map("unit_price") @db.Decimal(12,3)
  endsAt DateTime @map("ends_at") @db.Timestamptz(3)
  cycle String @default("MONTHLY") @db.VarChar(10)
  managed Boolean @default(false)
  periodStart DateTime @default(now()) @map("period_start") @db.Timestamptz(3)
  usageAnchorAt DateTime @default(now()) @map("usage_anchor_at") @db.Timestamptz(3)
  anchorDay Int @default(1) @map("anchor_day")
  cancelAtPeriodEnd Boolean @default(false) @map("cancel_at_period_end")
  automaticInvoices Boolean @default(false) @map("automatic_invoices")
  cancellationReason String @default("") @map("cancellation_reason") @db.VarChar(500)
  canceledAt DateTime? @map("canceled_at") @db.Timestamptz(3)
  graceEndsAt DateTime? @map("grace_ends_at") @db.Timestamptz(3)
  version Int @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expectedOrders BillingOrder[] @relation("ExpectedBillingSubscription")
  appliedOrders BillingOrder[] @relation("AppliedBillingSubscription")
  billingEvents BillingEvent[]
  @@unique([organizationId,id])
  @@index([organizationId,status])
  @@map("platform_subscriptions")
}

model PlatformInvoice {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  number String @unique @db.VarChar(80)
  amount Decimal @db.Decimal(12,3)
  currency String @default("OMR") @db.VarChar(3)
  status String @default("ISSUED") @db.VarChar(20)
  dueAt DateTime @map("due_at") @db.Timestamptz(3)
  ledger PlatformLedgerEntry[]
  billingOrderId String? @unique @map("billing_order_id") @db.Uuid
  billingOrder BillingOrder? @relation(fields:[organizationId,billingOrderId],references:[organizationId,id],onDelete:Restrict)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([organizationId,status])
  @@unique([organizationId,id])
  @@unique([organizationId,billingOrderId])
  @@map("platform_invoices")
}

model BillingOrder {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  membershipId String @map("membership_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  membership Membership @relation(fields:[organizationId,membershipId,userId],references:[organizationId,id,userId],onDelete:Restrict)
  sessionId String @map("session_id") @db.Uuid
  session UserSession @relation(fields:[sessionId,userId],references:[id,userId],onDelete:Restrict)
  planId String @map("plan_id") @db.Uuid
  plan PlatformPlan @relation(fields:[planId],references:[id],onDelete:Restrict)
  expectedSubscriptionId String? @map("expected_subscription_id") @db.Uuid
  expectedSubscription PlatformSubscription? @relation("ExpectedBillingSubscription",fields:[organizationId,expectedSubscriptionId],references:[organizationId,id],onDelete:Restrict)
  expectedSubscriptionVersion Int? @map("expected_subscription_version")
  appliedSubscriptionId String? @map("applied_subscription_id") @db.Uuid
  appliedSubscription PlatformSubscription? @relation("AppliedBillingSubscription",fields:[organizationId,appliedSubscriptionId],references:[organizationId,id],onDelete:Restrict)
  kind String @db.VarChar(20)
  status String @default("QUOTED") @db.VarChar(24)
  timing String @db.VarChar(16)
  cycle String @db.VarChar(10)
  seats Int
  unitPrice Decimal @map("unit_price") @db.Decimal(12,3)
  subtotal Decimal @db.Decimal(12,3)
  discount Decimal @db.Decimal(12,3)
  totalDue Decimal @map("total_due") @db.Decimal(12,3)
  renewalTotal Decimal @map("renewal_total") @db.Decimal(12,3)
  currency String @default("OMR") @db.VarChar(3)
  couponId String? @map("coupon_id") @db.Uuid
  coupon BillingCoupon? @relation(fields:[couponId],references:[id],onDelete:Restrict)
  couponSnapshot Json @default("{}") @map("coupon_snapshot")
  planSnapshot Json @map("plan_snapshot")
  effectiveAt DateTime @map("effective_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(3)
  appliedAt DateTime? @map("applied_at") @db.Timestamptz(3)
  canceledAt DateTime? @map("canceled_at") @db.Timestamptz(3)
  clientKey String? @map("client_key") @db.Uuid
  requestHash String? @map("request_hash") @db.VarChar(64)
  errorCode String? @map("error_code") @db.VarChar(60)
  version Int @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  invoice PlatformInvoice?
  couponUse BillingCouponUse?
  events BillingEvent[]
  @@unique([organizationId,id])
  @@unique([organizationId,clientKey])
  @@index([organizationId,status,createdAt])
  @@index([status,effectiveAt])
  @@map("billing_orders")
}
model BillingCouponUse {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  orderId String @unique @map("order_id") @db.Uuid
  order BillingOrder @relation(fields:[organizationId,orderId],references:[organizationId,id],onDelete:Restrict)
  couponId String @map("coupon_id") @db.Uuid
  coupon BillingCoupon @relation(fields:[couponId],references:[id],onDelete:Restrict)
  state String @default("RESERVED") @db.VarChar(16)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@unique([organizationId,orderId])
  @@index([couponId,state])
  @@index([organizationId,couponId,state])
  @@map("billing_coupon_uses")
}
model BillingEvent {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  membershipId String? @map("membership_id") @db.Uuid
  membership Membership? @relation(fields:[organizationId,membershipId],references:[organizationId,id],onDelete:Restrict)
  platformActorId String? @map("platform_actor_id") @db.Uuid
  platformActor PlatformAccount? @relation(fields:[platformActorId],references:[id],onDelete:Restrict)
  orderId String? @map("order_id") @db.Uuid
  order BillingOrder? @relation(fields:[organizationId,orderId],references:[organizationId,id],onDelete:Restrict)
  subscriptionId String? @map("subscription_id") @db.Uuid
  subscription PlatformSubscription? @relation(fields:[organizationId,subscriptionId],references:[organizationId,id],onDelete:Restrict)
  action String @db.VarChar(80)
  detail Json @default("{}")
  requestId String @default(uuid()) @map("request_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([organizationId,createdAt])
  @@map("billing_events")
}
model BillingTrialUse {
  organizationId String @id @map("organization_id") @db.Uuid
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  membershipId String @map("membership_id") @db.Uuid
  userId String @unique @map("user_id") @db.Uuid
  membership Membership @relation(fields:[organizationId,membershipId,userId],references:[organizationId,id,userId],onDelete:Restrict)
  planId String @map("plan_id") @db.Uuid
  plan PlatformPlan @relation(fields:[planId],references:[id],onDelete:Restrict)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@map("billing_trial_uses")
}
model PlatformLedgerEntry {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  invoiceId String? @map("invoice_id") @db.Uuid
  invoice PlatformInvoice? @relation(fields:[invoiceId],references:[id],onDelete:Restrict)
  reference String @unique @db.VarChar(100)
  direction String @db.VarChar(8)
  amount Decimal @db.Decimal(12,3)
  currency String @default("OMR") @db.VarChar(3)
  note String @db.VarChar(500)
  actorId String? @map("actor_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([organizationId,createdAt])
  @@map("platform_ledger_entries")
}

model PlatformPage {
  id String @id @default(uuid()) @db.Uuid
  slug String @unique @db.VarChar(100)
  title String @db.VarChar(160)
  body String @db.Text
  status String @db.VarChar(20)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@map("platform_pages")
}

model PlatformSettings {
  id String @id @default("main") @db.VarChar(10)
  platformName String @map("platform_name") @db.VarChar(120)
  supportEmail String @map("support_email") @db.VarChar(254)
  footerText String @map("footer_text") @db.VarChar(300)
  maintenanceMode Boolean @default(false) @map("maintenance_mode")
  publicPagesEnabled Boolean @default(true) @map("public_pages_enabled")
  sessionMinutes Int @default(60) @map("session_minutes")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@map("platform_settings")
}

model OrganizationSettings {
 taskCategories String[] @default([]) @map("task_categories")
 projectCategories String[] @default([]) @map("project_categories")
  organizationId String @id @map("organization_id") @db.Uuid
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  description String @default("") @db.VarChar(2000)
  businessType String @default("") @map("business_type") @db.VarChar(120)
  email String @default("") @db.VarChar(254)
  phone String @default("") @db.VarChar(40)
  address String @default("") @db.VarChar(500)
  country String @default("OM") @db.VarChar(2)
