{
  "name": "@work/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/main.ts",
    "build": "tsc -p tsconfig.json && node ../../infrastructure/scripts/prepare-api-assets.mjs",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:validate": "prisma validate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.922.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "~6.19.0",
    "@work/shared-schemas": "workspace:*",
    "@work/shared-types": "workspace:*",
    "bullmq": "^5.63.0",
    "exceljs": "4.4.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.0",
    "nodemailer": "^10.3.1",
    "pdfjs-dist": "6.5.438",
    "playwright-core": "1.64.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/multer": "^2.3.0",
    "@types/nodemailer": "^8.0.2",
    "nodemon": "^3.1.10",
    "prisma": "~6.19.0",
    "ts-node": "^10.9.2"
  }
}
